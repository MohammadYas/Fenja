# Selja · alle nødvendige nøgler — dokumenteret, INGEN værdier (HANDOFF §5.2).
# Kopiér til .env.local og udfyld. Server-nøgler må ALDRIG eksponeres i klienten (NFR-6).

# ── Supabase ────────────────────────────────────────────────────────────────
# Fra `supabase start` lokalt eller cloud-projektets API-indstillinger (HANDOFF §6.2-3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# KUN server-side (webhooks, jobs) — aldrig NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=

# ── fal.ai (billedgenerering bag ImageProvider, HANDOFF §6.4) ───────────────
FAL_KEY=

# ── Google Gemini (billedgenerering bag ImageProvider — Gate 1-trekamp) ─────
# Rigtige kald sker kun bag --live i gate1-scriptet eller når billedProvidere
# i lib/config.ts vælger gemini. Model-id'er styres i config, ikke her.
GEMINI_API_KEY=

# ── Anthropic (annoncetekst, D-1) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Stripe (kreditpakker, E-2; testmode først, HANDOFF §6.5) ────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Pris-id'er for abonnementerne (pricing v3.0) — oprettes i Stripe testmode.
# Uden værdier bruges pladsholderne fra lib/config.ts (stripePriser).
STRIPE_PRICE_PLUS_MD=
STRIPE_PRICE_PLUS_AAR=
STRIPE_PRICE_PRO_MD=
STRIPE_PRICE_PRO_AAR=

# ── Trigger.dev (item-pipeline, HANDOFF §6.6) ───────────────────────────────
TRIGGER_SECRET_KEY=

# ── Resend (transaktionsmails: velkomst, "din annonce er klar", HANDOFF §6.6) ─
# Login bruger nu e-mail+adgangskode (ikke magic link), så Resend er kun til
# transaktionsmails. Uden nøgle mockes de (keyless-sikkert).
RESEND_API_KEY=
# Afsenderadresse, fx "Selja <post@selja.dk>" — uden værdi bruges Resends sandbox-afsender
RESEND_FROM=

# ── Admin (G-1 omkostningsside) ─────────────────────────────────────────────
# E-mailen på ejerens konto. /admin er kun synlig for præcis denne bruger;
# alle andre får 404. Log ind som normal bruger med denne e-mail for adgang.
ADMIN_EMAIL=

# ── Drift ───────────────────────────────────────────────────────────────────
# Sidens offentlige base-URL (robots, sitemap, links i transaktionsmails).
# Uden værdi bruges https://selja.studio som fallback.
NEXT_PUBLIC_SITE_URL=
# Globalt dagligt API-budgetloft i kr.; overskrides det, stopper nye jobs (E-5)
DAILY_BUDGET_CAP_DKK=
